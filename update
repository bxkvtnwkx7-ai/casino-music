local speaker = peripheral.wrap("right")

if not speaker then
  print("No speaker")
  return
end

local function n(inst, pitch, delay)
  speaker.playNote(inst, pitch, 1)
  sleep(delay)
end

while true do
  -- intro piano feel
  n("harp", 1, 0.4)
  n("harp", 2, 0.4)
  n("harp", 3, 0.6)

  -- bass line
  n("bass", 1, 0.6)
  n("harp", 2, 0.3)
  n("harp", 3, 0.3)

  -- card deal accent
  n("pling", 1, 0.5)
  n("harp", 4, 0.7)

  -- loop resolution
  n("bass", 1, 0.6)
  n("harp", 2, 0.5)
  n("harp", 3, 0.7)

  sleep(1)
end
