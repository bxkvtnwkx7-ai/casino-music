local speaker = peripheral.wrap("right")

if not speaker then
  print("No speaker on right")
  return
end

local function n(inst, pitch, delay)
  speaker.playNote(inst, pitch, 1)
  sleep(delay)
end

while true do
  -- soft intro (piano feel)
  n("harp", 1, 0.5)
  n("harp", 3, 0.5)
  n("harp", 5, 0.7)

  -- walking bass line
  n("bass", 1, 0.6)
  n("bass", 1, 0.6)
  n("harp", 3, 0.4)

  -- jazz lift
  n("harp", 5, 0.4)
  n("harp", 6, 0.4)
  n("pling", 1, 0.6)

  -- resolution phrase (slower, cleaner)
  n("harp", 3, 0.5)
  n("bass", 1, 0.5)
  n("harp", 5, 0.8)

  sleep(0.8)
end
