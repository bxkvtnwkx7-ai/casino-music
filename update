local speaker = peripheral.wrap("right")

if not speaker then
  print("No speaker on right")
  return
end

local function note(sound, pitch, delay)
  speaker.playSound(sound, 1, pitch)
  sleep(delay)
end

while true do
  -- soft piano intro
  note("note.harp", 1.0, 0.4)
  note("note.harp", 1.2, 0.4)
  note("note.harp", 1.5, 0.6)

  -- bass lounge rhythm
  note("note.bass", 0.8, 0.6)
  note("note.harp", 1.0, 0.3)
  note("note.harp", 1.2, 0.3)

  -- “card deal” accent
  note("note.pling", 1.0, 0.5)
  note("note.harp", 1.6, 0.7)

  -- soft reset phrase
  note("note.bass", 0.7, 0.6)
  note("note.harp", 1.0, 0.4)
  note("note.harp", 1.3, 0.7)

  sleep(1)
end
